# Copy this file to `secrets.toml` (same folder) and fill in your real values.
# Never commit the real secrets.toml to git — it's already in .gitignore.
#
# When deploying to Streamlit Community Cloud, paste this same content
# (with real values) into your app's Settings -> Secrets instead of using a file.

SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_KEY = "your-service-role-key-here"
GEMINI_API_KEY = "your-gemini-api-key-here"
